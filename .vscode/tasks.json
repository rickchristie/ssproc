{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Package",
			"type": "shell",
			"command": "go test -v -c -o /dev/null ./...",
			"problemMatcher": ["$go"],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "pgflock: up",
			"type": "shell",
			"command": "pgflock up",
			"problemMatcher": [],
			"isBackground": true,
			"group": "test",
			"presentation": {
				"group": "test-infra",
				"close": true
			}
		},
		{
			"label": "gowt: Run All Tests",
			"type": "shell",
			"command": "go clean -testcache && gowt ./...",
			"problemMatcher": ["$go"],
			"group": "test",
			"presentation": {
				"group": "test-infra",
				"close": true
			}
		}
	]
}