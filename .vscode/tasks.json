{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Test Infrastructure",
			"type": "shell",
			"command": "cd ${workspaceFolder}/pgtest && ./test-infra-build.sh",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run Test Infrastructure",
			"type": "shell",
			"command": "cd ${workspaceFolder}/pgtest && ./test-infra-run.sh",
			"problemMatcher": [],
			"isBackground": true
		},
		{
			"label": "Build Package",
			"type": "shell",
			"command": "go test -v -c -o /dev/null ./...",
			"problemMatcher": ["$go"],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "pgflock up",
			"type": "shell",
			"command": "pgflock up",
			"problemMatcher": [],
			"isBackground": true
		}
	]
}